{
  "ReverseProxy": {
    "Routes": {
      "user": {
        "ClusterId": "usercluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "product": {
        "ClusterId": "productcluster",
        "Match": { "Path": "/api/products/{**catch-all}" }
      },
      "order": {
        "ClusterId": "ordercluster",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "admin": {
        "ClusterId": "admincluster",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "search": {
        "ClusterId": "searchcluster",
        "Match": { "Path": "/api/search/{**catch-all}" }
      }
    },
    "Clusters": {
      "usercluster": {
        "Destinations": { "user": { "Address": "http://localhost:5001/" } }
      },
      "productcluster": {
        "Destinations": { "product": { "Address": "http://localhost:5002/" } }
      },
      "ordercluster": {
        "Destinations": { "order": { "Address": "http://localhost:5003/" } }
      },
      "admincluster": {
        "Destinations": { "admin": { "Address": "http://localhost:5004/" } }
      },
      "searchcluster": {
        "Destinations": { "search": { "Address": "http://localhost:5005/" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Authority": "https://your-auth-server/",
    "Audience": "your-api-audience"
  }
}
