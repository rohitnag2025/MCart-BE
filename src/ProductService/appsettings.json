{
  "ConnectionStrings": {
    "DefaultConnection": "${SQLSERVER_CONNECTION_STRING}"
  },
  "AzureBlob": {
    "ConnectionString": "${AZUREBLOB_CONNECTION_STRING}",
    "ContainerName": "${AZUREBLOB_CONTAINER_NAME}",
    "BlobEndpoint": "${AZUREBLOB_BLOB_ENDPOINT}"
  },
  "ServiceBus": {
    "ConnectionString": "${SERVICEBUS_CONNECTION_STRING}",
    "QueueName": "${SERVICEBUS_QUEUE_NAME}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:4200"
  }
}
