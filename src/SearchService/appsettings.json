{
  "AzureSearch": {
      "Endpoint": "${AZURE_SEARCH_ENDPOINT}",
      "ApiKey": "${AZURE_SEARCH_API_KEY}",
      "IndexName": "${AZURE_SEARCH_INDEX_NAME}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
