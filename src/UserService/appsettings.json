{
  "ConnectionStrings": {
    "DefaultConnection": "${SQLSERVER_CONNECTION_STRING}"
  },
  "AzureAdB2C": {
    "Instance": "${AZUREADB2C_INSTANCE}",
    "ClientId": "${AZUREADB2C_CLIENTID}",
    "Domain": "${AZUREADB2C_DOMAIN}",
    "SignUpSignInPolicyId": "${AZUREADB2C_SIGNUP_SIGNIN_POLICYID}",
    "ResetPasswordPolicyId": "${AZUREADB2C_RESET_PASSWORD_POLICYID}",
    "EditProfilePolicyId": "${AZUREADB2C_EDIT_PROFILE_POLICYID}"
  },
  "SendGrid": {
    "ApiKey": "${SENDGRID_API_KEY}"
  },
  "Jwt": {
    "Secret": "${JWT_SECRET}"
  },
  "Authentication": {
    "Facebook": {
      "AppId": "${FACEBOOK_APP_ID}",
      "AppSecret": "${FACEBOOK_APP_SECRET}"
    },
    "Twitter": {
      "ConsumerAPIKey": "${TWITTER_API_KEY}",
      "ConsumerSecret": "${TWITTER_API_SECRET}"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://127.0.0.1:4200,http://localhost:4200,http://127.0.0.1:5123,https://127.0.0.1:7086"
  },
  "Frontend": {
    "SocialCallbackUrl": "http://127.0.0.1:4200/auth/social-callback"
  }
}